{
  "mcpServers": {
<%#
  devcontainer: one container is shared by every parallel Claude session, and a
  stdio server is spawned per session -- `npx` wrapper plus the server itself,
  ~190MB and 3 processes each. A single `@playwright/mcp --port 8931` daemon
  serves them all instead; each client still gets its own MCP session and its
  own browser. The daemon is started by the launcher (mise task) before claude.
  Host role keeps stdio: there is no daemon to talk to there.

  The server rejects requests whose Host header does not match what it bound to,
  so the URL must say localhost, not 127.0.0.1.
-%>
<%- if ENV['DOTFILES_ROLE'] == 'devcontainer' -%>
    "playwright": {
      "type": "http",
      "url": "http://localhost:8931/mcp"
    },
<%- else -%>
    "playwright": {
      "command": "<%= ENV['HOME'] %>/.local/share/mise/shims/npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
<%- end -%>
    "todoist": {
      "type": "http",
      "url": "https://ai.todoist.net/mcp"
    },
    "adcom": {
      "type": "http",
      "url": "https://api.x-ad.com/mcp"
    },
<%#
  yui speaks streamable HTTP directly, which Claude Code supports natively, so
  the supergateway stdio bridge in front of it was pure overhead: an `npx`
  wrapper plus a node process (~190MB, 3 PIDs) spawned per session.
-%>
<%- yui_host = ENV['DOTFILES_ROLE'] == 'devcontainer' ? 'host.docker.internal' : 'localhost' -%>
    "yui": {
      "type": "http",
      "url": "http://<%= yui_host %>:52981/mcp"
    },
<%- context7_api_key = ENV['CONTEXT7_API_KEY'].to_s.strip -%>
    "context7": {
      "type": "http",
<%- if context7_api_key.empty? -%>
      "url": "https://mcp.context7.com/mcp"
<%- else -%>
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer <%= context7_api_key %>"
      }
<%- end -%>
    },
    "codex": {
<%#
  devcontainer: ~/.codex is a rw bind mount shared with the host, so
  roles/base renders config.toml / AGENTS.md into ~/.config/codex instead.
  Claude Code spawns this server without a login shell, so the
  config/.zsh/lib/apps export is not inherited -- set CODEX_HOME here too.
-%>
<%- if ENV['DOTFILES_ROLE'] == 'devcontainer' -%>
      "env": {
        "CODEX_HOME": "<%= ENV['HOME'] %>/.config/codex"
      },
<%- end -%>
      "command": "codex",
      "args": [
        "mcp-server",
        "-c", "approval_policy=never",
        "-c", "sandbox_mode=workspace-write"
      ]
    }
  }
}

