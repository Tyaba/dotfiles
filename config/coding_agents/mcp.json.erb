{
  "mcpServers": {
    "playwright": {
      "command": "<%= ENV['HOME'] %>/.local/share/mise/shims/npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "todoist": {
      "type": "http",
      "url": "https://ai.todoist.net/mcp"
    },
    "adcom": {
      "type": "http",
      "url": "https://api.x-ad.com/mcp"
    },
    "yui": {
      "command": "<%= ENV['HOME'] %>/.local/share/mise/shims/npx",
<%- yui_host = ENV['DOTFILES_ROLE'] == 'devcontainer' ? 'host.docker.internal' : 'localhost' -%>
      "args": ["-y", "supergateway", "--streamableHttp", "http://<%= yui_host %>:52981/mcp"]
    },
<%- context7_api_key = ENV['CONTEXT7_API_KEY'].to_s.strip -%>
    "context7": {
      "type": "http",
<%- if context7_api_key.empty? -%>
      "url": "https://mcp.context7.com/mcp"
<%- else -%>
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer <%= context7_api_key %>"
      }
<%- end -%>
    },
    "codex": {
<%#
  devcontainer: ~/.codex is a rw bind mount shared with the host, so
  roles/base renders config.toml / AGENTS.md into ~/.config/codex instead.
  Claude Code spawns this server without a login shell, so the
  config/.zsh/lib/apps export is not inherited -- set CODEX_HOME here too.
-%>
<%- if ENV['DOTFILES_ROLE'] == 'devcontainer' -%>
      "env": {
        "CODEX_HOME": "<%= ENV['HOME'] %>/.config/codex"
      },
<%- end -%>
      "command": "codex",
      "args": [
        "mcp-server",
        "-c", "approval_policy=never",
        "-c", "sandbox_mode=workspace-write"
      ]
    }
  }
}

