approval_policy = "never"
<% if ENV['DOTFILES_ROLE'] == 'devcontainer' -%>
# devcontainer: container 隔離で blast radius が container 内に閉じるため
# danger-full-access に昇格する。/tmp, ~/.cache, ~/.config 等への書き込みも自由
sandbox_mode = "danger-full-access"
<% else -%>
sandbox_mode = "workspace-write"
<% end -%>

# model は固定しない。ChatGPT アカウント認証では使えるモデルがアカウント側で決まり、
# 使えないモデルを書くと全リクエストが HTTP 400 になる。model_context_window も
# 特定モデル前提の値なので、モデルの既定に任せる
model_reasoning_effort = "high"

# 認証情報は keyring ではなく $CODEX_HOME/auth.json に保存する。devcontainer は
# host の ~/.codex/auth.json を bind mount 経由で共有するため、keyring だと読めない
cli_auth_credentials_store = "file"

<% if ENV['DOTFILES_ROLE'] == 'devcontainer' -%>
# danger-full-access では [sandbox_workspace_write] セクションは bypass されるため省略
<% else -%>
[sandbox_workspace_write]
writable_roots = ["<%= ENV['HOME'] %>/ghq"]
network_access = true
<% end -%>

<%- context7_api_key = ENV['CONTEXT7_API_KEY'].to_s.strip -%>
[mcp_servers.context7]
command = "<%= ENV['HOME'] %>/.local/share/mise/shims/npx"
args = ["-y", "@upstash/context7-mcp"]
<% unless context7_api_key.empty? -%>
# API key は args ではなく env で渡す。args だと `ps` に鍵が露出する
env = { CONTEXT7_API_KEY = "<%= context7_api_key %>" }
<% end -%>
