#!/usr/bin/env bash
set -euo pipefail

resolve_path() (
  local target=$1
  if command -v realpath >/dev/null 2>&1; then
    realpath "$target" 2>/dev/null && exit 0
  fi

  # Resolve symlinks even when PATH contains only shim directories.
  case "$target" in
    /*) ;;
    *) target="$PWD/$target" ;;
  esac
  while true; do
    CDPATH= cd -P -- "${target%/*}" || exit 1
    target="$(pwd -P)/${target##*/}"
    if [[ ! -L "$target" ]]; then
      printf '%s\n' "$target"
      exit 0
    fi
    target=$(/usr/bin/readlink "$target") || exit 1
    case "$target" in
      /*) ;;
      *) target="$PWD/$target" ;;
    esac
  done
)

if [[ "${1-}" == auth && ( "${2-}" == login || "${2-}" == refresh ) ]]; then
  insecure_storage=false
  for arg in "$@"; do
    case "$arg" in
      --insecure-storage|--insecure-storage=*)
        insecure_storage=true
        break
        ;;
    esac
  done
  if [[ "$insecure_storage" == false ]]; then
    set -- "$@" --insecure-storage
    printf '%s\n' 'gh: added --insecure-storage because devcontainers read the token from ~/.config/gh/hosts.yml' >&2
  fi
fi

self=$(resolve_path "$0")
remaining_path=${PATH-}
while true; do
  path_entry=${remaining_path%%:*}
  candidate="${path_entry:-.}/gh"
  if [[ -f "$candidate" && -x "$candidate" ]]; then
    if candidate_path=$(resolve_path "$candidate") && [[ "$candidate_path" != "$self" ]]; then
      exec "$candidate" "$@"
    fi
  fi
  case "$remaining_path" in
    *:*) remaining_path=${remaining_path#*:} ;;
    *) break ;;
  esac
done

printf '%s\n' 'gh: real gh not found in PATH' >&2
exit 127
