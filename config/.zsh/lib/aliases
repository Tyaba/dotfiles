# インタラクティブシェルでのみ alias を設定
if [[ -o interactive ]]; then
    # bat replaces cat
    alias cat="bat"
    # rip grep replaces grep
    alias grep="rg"
    # exa replaces ls
    alias ls="exa"
    # procs replaces ps
    alias ps="procs"
    # fd replaces find
    alias find="fd"
    # bottom replaces top
    alias top="btm"
    # dust replaces du
    alias du="dust"
    # クリップボードコピー/ペースト
    if [[ -n "$WAYLAND_DISPLAY" ]] && (( $+commands[wl-copy] )); then
        alias pbcopy="wl-copy"
        alias pbpaste="wl-paste --no-newline"
    else
        alias pbcopy="xclip -selection clipboard"
        alias pbpaste="xclip -selection c -o"
    fi
fi

alias python3="python"
# cargo-script
alias rust="cargo-script"
# Docker
alias d=docker
