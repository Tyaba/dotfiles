[tools]
ghq = "latest"
python = ["3.14", "3.12"]
terraform = "latest"
kubectl = "latest"
node = "24"
pnpm = "latest"
flutter = "latest"
ruby = "latest"
go = "latest"
"npm:@devcontainers/cli" = "latest"
# Unpinned again: the 0.153.0 pin existed only because Claude Code reached codex
# through `codex mcp-server`, which 0.154.0 removed. Offloading now goes through
# `codex exec` (see config/coding_agents/claude/agents/codex-offload.md), a core
# subcommand present in both 0.153.0 and 0.154.0, so there is nothing left to
# pin to. Keep this in sync with CODEX_VERSION in roles/devcontainer/default.rb.
"npm:@openai/codex" = "latest"

[settings]
experimental = true
legacy_version_file_disable_tools = ["terraform", "packer"]
# MCP servers launched through mise shims (playwright/yui) may start from git worktrees.
# mise trust is path-scoped, so each new worktree exposes a new .mise.toml path and
# is rejected before the server can start. Trust the normal clone roots instead.
# Trade-off: mise configs in third-party repositories cloned under these paths are also trusted.
trusted_config_paths = ["~/ghq", "/workspaces"]

[settings.python]
compile = true

[env]
BASH_DEFAULT_TIMEOUT_MS = 1800000
BASH_MAX_TIMEOUT_MS = 1800000
