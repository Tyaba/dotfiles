[tools]
ghq = "latest"
python = ["3.14", "3.12"]
terraform = "latest"
kubectl = "latest"
node = "24"
pnpm = "latest"
flutter = "latest"
ruby = "latest"
go = "latest"
"npm:@devcontainers/cli" = "latest"
# Pinned, not "latest": codex 0.154.0 removed the `mcp-server` subcommand that
# the codex MCP entry in config/coding_agents/mcp.json.erb starts. On 0.154.0
# `codex mcp-server` is parsed as the optional [PROMPT] positional, so codex
# tries to open its interactive TUI and exits ("TERM is set to \"dumb\"") and
# Claude Code reports the codex server as a failed connection. 0.153.0 is the
# last version that still serves MCP over stdio. Keep this in sync with
# CODEX_VERSION in roles/devcontainer/default.rb.
"npm:@openai/codex" = "0.153.0"

[settings]
experimental = true
legacy_version_file_disable_tools = ["terraform", "packer"]
# MCP servers launched through mise shims (playwright/yui) may start from git worktrees.
# mise trust is path-scoped, so each new worktree exposes a new .mise.toml path and
# is rejected before the server can start. Trust the normal clone roots instead.
# Trade-off: mise configs in third-party repositories cloned under these paths are also trusted.
trusted_config_paths = ["~/ghq", "/workspaces"]

[settings.python]
compile = true

[env]
BASH_DEFAULT_TIMEOUT_MS = 1800000
BASH_MAX_TIMEOUT_MS = 1800000
