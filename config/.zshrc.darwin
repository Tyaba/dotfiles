#!/bin/zsh
# Homebrew
export PATH="/opt/homebrew/bin:$PATH"
# eval "$(/opt/homebrew/bin/brew shellenv)"
export HOMEBREW_CASK_OPTS="--appdir=/Applications"

export PATH="/usr/local/sbin:/usr/local/opt/libarchive/bin:$PATH"
alias nproc="sysctl -n hw.logicalcpu"
alias clion="open -na 'CLion.app'"

# Ruby
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
# You must edit the version if ruby's latest changes in brew
export PATH="/opt/homebrew/lib/ruby/gems/3.2.0/bin:$PATH"

# export OPENBLAS=$(/opt/homebrew/bin/brew --prefix openblas)
export CFLAGS="-falign-functions=8 ${CFLAGS}"

# Colima (Docker daemon on macOS via Lima VM)
# ~/.colima/default/docker.sock is created by `colima start`.
# `docker context use colima` sets this automatically, but we export it
# explicitly so tools that don't consult docker contexts (e.g. some CI
# helpers, devcontainer CLI in edge cases) still find the daemon.
export DOCKER_HOST=unix://${HOME}/.colima/default/docker.sock

# GNU sed
alias sed=gsed

# Kubectl
export USE_GKE_GCLOUD_AUTH_PLUGIN=True

# hdf5
#export HDF5_DIR=$(/opt/homebrew/bin/brew --prefix hdf5)

# Google Cloud SDK Python setting
export CLOUDSDK_PYTHON=$HOME/.local/share/mise/installs/python/3.12/bin/python

# PulseAudioを起動し、認証クッキーを自動同期してSSH接続する関数
function ssh-sound() {
  # 接続先ホスト名が指定されていない場合はエラー
  if [ -z "$1" ]; then
    echo "Usage: ssh-sound <hostname>"
    return 1
  fi

  local host="$1" # 最初の引数をホスト名として保存

  # 1. PulseAudioサーバーの起動チェック
  if ! pgrep -x "pulseaudio" > /dev/null; then
    echo "🚀 Starting PulseAudio with authentication enabled..."
    pulseaudio --load="module-native-protocol-tcp auth-ip-acl=127.0.0.1 auth-cookie=$HOME/.config/pulse/cookie" --exit-idle-time=-1 --daemon
    sleep 1 # デバイス検出を待つ
  else
    echo "🎧 PulseAudio is already running."
    # 既に起動している場合、TCPモジュールが正しく設定されているか確認
    if ! pactl list modules short | grep -q "module-native-protocol-tcp"; then
      echo "🔧 Loading TCP module with authentication..."
      pactl load-module module-native-protocol-tcp auth-ip-acl=127.0.0.1 auth-cookie=$HOME/.config/pulse/cookie
    fi
  fi

  # macOSのデフォルト出力デバイスに合わせてPulseAudioのデフォルトシンクを設定
  # system_profilerでデフォルト出力デバイス名を取得
  local macos_default=$(system_profiler SPAudioDataType 2>/dev/null | awk '/:$/ {device=$0} /Default Output Device: Yes/ {print device; exit}' | sed 's/^[[:space:]]*//;s/:$//')

  if [ -n "$macos_default" ]; then
    # PulseAudioのシンク一覧から対応するシンクを検索
    local pa_sink=$(pactl list sinks | grep -B 4 "Description: $macos_default" | grep "Name:" | awk '{print $2}' | head -1)

    if [ -n "$pa_sink" ]; then
      echo "🔊 Setting default sink to: $macos_default ($pa_sink)"
      pactl set-default-sink "$pa_sink" 2>/dev/null || echo "⚠️ Failed to set default sink"
    fi
  fi

  # 2. 認証クッキーの自動同期
  echo "🔑 Checking authentication cookie for $host..."

  # Mac上のクッキーファイルのパス
  local local_cookie_file="$HOME/.config/pulse/cookie"
  # リモート(Linux)上のクッキーファイルのパス
  local remote_cookie_file="~/.config/pulse/cookie"

  # Macにクッキーファイルが存在するか確認
  if [ ! -f "$local_cookie_file" ]; then
      echo "⚠️ Local PulseAudio cookie not found. Please run a sound application once."
      return 1
  fi

  # Macのクッキーのハッシュ値と、Linuxのクッキーのハッシュ値を取得
  local local_hash=$(shasum "$local_cookie_file" | awk '{print $1}')
  local remote_hash=$(ssh "$host" "shasum $remote_cookie_file 2>/dev/null | awk '{print \$1}'")

  # ハッシュ値を比較し、異なっていればscpでコピー
  if [ "$local_hash" != "$remote_hash" ]; then
    echo "🔄 Cookie is outdated. Syncing..."
    # リモート側にディレクトリが存在しない場合は作成
    ssh "$host" "mkdir -p ~/.config/pulse"
    scp -q "$local_cookie_file" "${host}:${remote_cookie_file}"
    if [ $? -eq 0 ]; then
      echo "✅ Cookie successfully synced."
    else
      echo "❌ Failed to sync cookie."
      return 1
    fi
  else
    echo "👍 Cookie is already up-to-date."
  fi

  # 3. SSH接続の実行
  echo "📡 Connecting to $host with audio forwarding..."
  ssh "$@"
}
