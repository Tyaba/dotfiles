[Unit]
Description=yui MCP proxy (gcloud run services proxy)

[Service]
Type=simple
Environment=CLOUDSDK_ACTIVE_CONFIG_NAME=<%= @gcloud_configuration %>
ExecStart=%h/.bin/google-cloud-sdk/bin/gcloud run services proxy yui-backend --region=asia-northeast1 --port=52981
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
